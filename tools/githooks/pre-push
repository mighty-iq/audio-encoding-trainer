#!/bin/sh
# Before every push: generated files are current, then the privacy check (owner's standing rules, Privacy).
# Enable once per clone:  git config core.hooksPath tools/githooks
# Git passes the remote's name and URL as arguments and the refs to push on stdin.
top="$(git rev-parse --show-toplevel)"
# The script block in index.html and the licence texts must match the files on disk (a pack once went unlisted).
node "$top/tools/build-index.mjs" --check >&2 || { echo "pre-push: index.html is stale; run node tools/build-index.mjs and commit" >&2; exit 1; }
node "$top/tools/build-licences.mjs" --check >&2 || { echo "pre-push: licence texts are stale; run node tools/build-licences.mjs and commit" >&2; exit 1; }
exec python3 "$top/tools/privacy_check.py" --hook "$1" "$2"
